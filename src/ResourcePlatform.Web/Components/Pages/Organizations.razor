@page "/organizations"
@attribute [Authorize]
@inject AppDbContext Db
@inject ICurrentUser CurrentUser

<PageTitle>Organizations</PageTitle>
<h1>Your organizations</h1>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="error">@Error</div>
}

@if (memberships.Count == 0)
{
    <div class="card"><p>You are not a member of any organization yet. Create one below.</p></div>
}
else
{
    <table>
        <thead><tr><th>Organization</th><th>Your role</th><th></th></tr></thead>
        <tbody>
        @foreach (var m in memberships)
        {
            <tr>
                <td>@m.Name</td>
                <td>@m.Role</td>
                <td>
                    <form method="post" action="/ui/select-org" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="organizationId" value="@m.Id" />
                        <button class="link" type="submit">Open</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<h2>Create an organization</h2>
<form method="post" action="/ui/organizations/create" class="stack card">
    <AntiforgeryToken />

    <label for="name">Name</label>
    <input id="name" name="name" required maxlength="@OrganizationRules.NameMaxLength"
           placeholder="Nashville Medical Group" />

    <label for="slug">URL name <span class="muted">(optional)</span></label>
    <input id="slug" name="slug" maxlength="@OrganizationRules.SlugMaxLength"
           pattern="@OrganizationRules.SlugPattern.Trim('^', '$')"
           title="Lowercase letters, digits, and single hyphens"
           placeholder="nashville-medical-group" />
    <p class="muted hint">Leave blank to generate one from the name.</p>

    <button class="btn" type="submit">Create organization</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private List<Row> memberships = [];

    private sealed record Row(Guid Id, string Name, string Role);

    protected override async Task OnInitializedAsync()
    {
        var userId = CurrentUser.UserId!.Value;

        // Deliberately cross-tenant: this page exists to choose a tenant
        memberships = await Db.Memberships
            .IgnoreQueryFilters()
            .AsNoTracking()
            .Where(m => m.UserId == userId && m.Status == MembershipStatus.Active)
            .OrderBy(m => m.Organization!.Name)
            .Select(m => new Row(m.Organization!.Id, m.Organization.Name, m.Role!.Name))
            .ToListAsync();
    }
}